{
  "name": "webui-2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "WebUI-2 v2 frontend — Vite 6 + React 19 + TypeScript strict, FSD architecture",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tokens:build": "node style-dictionary.config.mjs",
    "openapi": "node scripts/export-openapi.mjs",
    "check:assets": "node scripts/check-asset-registry.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5",
    "@tanstack/react-virtual": "^3.10.8",
    "motion": "^12.42.2",
    "phaser": "^4.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "7",
    "zustand": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.48",
    "@storybook/addon-a11y": "^8",
    "@storybook/addon-essentials": "^8",
    "@storybook/addon-viewport": "^8",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8",
    "@storybook/test": "^8.6.18",
    "@tailwindcss/vite": "^4",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "@vitest/ui": "^3.2.7",
    "eslint": "^9",
    "eslint-config-prettier": "^9",
    "eslint-plugin-jsx-a11y": "^6",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-react-refresh": "^0.4",
    "jest-axe": "^10.0.0",
    "jsdom": "^25",
    "lint-staged": "^17.1.1",
    "orval": "^7",
    "prettier": "^3",
    "storybook": "^8",
    "style-dictionary": "^4",
    "tailwindcss": "^4",
    "typescript": "~5.6",
    "typescript-eslint": "^8",
    "vite": "^6",
    "vitest": "^3.2.7"
  }
}
